{
  "name": "mahafeth-platform",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.12.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/client",
      "@prisma/engines",
      "@tailwindcss/oxide",
      "esbuild",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=@mahafeth/web",
    "dev:admin": "turbo run dev --filter=@mahafeth/admin",
    "dev:backend": "turbo run dev --filter=@mahafeth/backend",
    "build": "turbo run build",
    "start:web": "pnpm --filter @mahafeth/web start",
    "start:backend": "pnpm --filter @mahafeth/backend start",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:e2e:leads": "node e2e/leads.e2e.mjs",
    "test:e2e:dashboard": "node e2e/dashboard.e2e.mjs",
    "test:e2e:users": "node e2e/users-audit.e2e.mjs",
    "test:e2e:security": "node e2e/security-audit.e2e.mjs",
    "test:e2e:admin-routes": "node e2e/admin-routes.e2e.mjs",
    "test:smoke": "node e2e/production-smoke.mjs",
    "backup:db": "node scripts/backup/backup-db.mjs",
    "backup:media": "node scripts/backup/backup-media.mjs",
    "backup": "node scripts/backup/backup-db.mjs && node scripts/backup/backup-media.mjs",
    "restore:db": "node scripts/backup/restore-db.mjs",
    "clean": "turbo run clean",
    "db:up": "docker compose up -d mysql",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @mahafeth/backend db:generate",
    "db:migrate": "pnpm --filter @mahafeth/backend db:migrate",
    "db:deploy": "pnpm --filter @mahafeth/backend db:deploy",
    "db:seed": "pnpm --filter @mahafeth/backend db:seed",
    "db:studio": "pnpm --filter @mahafeth/backend db:studio"
  },
  "devDependencies": {
    "@mahafeth/prettier-config": "workspace:*",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.11.5",
    "typescript": "6.0.3"
  }
}
