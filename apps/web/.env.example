# Copy to `.env.local` for development. On the production server put the production values in
# `.env.production.local` (never committed). NEXT_PUBLIC_* values are baked into the bundle at
# `next build`, so rebuild after changing them. See docs/production-deployment.md.
#
# Production builds refuse missing or localhost/http values for NEXT_PUBLIC_SITE_URL and
# NEXT_PUBLIC_API_URL. For a production build on a developer machine, set ALLOW_LOCAL_URLS=true
# (local files only, never on the server).

# Public origin, used for canonical URLs, hreflang alternates, sitemap, robots and Open Graph.
# Production: https://mahafeth.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public API base, used by the browser (interest form). Production: https://mahafeth.com/api/v1
# (Nginx proxies /api/v1 on the website domain to the backend, so no CORS is involved).
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Server-only API base for page rendering and the /uploads rewrite. Production:
# http://127.0.0.1:4000/api/v1 (straight to the backend, skipping Nginx and TLS).
# Defaults to NEXT_PUBLIC_API_URL. Needed at build time as well as at runtime.
CMS_API_URL=

# Read content from the CMS. When the API is unreachable, empty or this is `false`,
# pages use the bundled content in src/content/fallback.
CMS_ENABLED=true

# Shared with the backend (same value as apps/backend REVALIDATE_SECRET): lets it refresh CMS
# content on /api/revalidate after admin changes. Leave empty to disable (content then refreshes
# every 5 minutes). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
REVALIDATE_SECRET=

# CDN origin, only when uploads are served from a CDN instead of /uploads (optional). This is the
# only remote host the image optimizer accepts.
CMS_MEDIA_URL=

# Lenis smooth scrolling. The design source uses native scrolling, so this stays
# off until the motion-parity review signs off on the feel.
NEXT_PUBLIC_SMOOTH_SCROLL=false

# CDN URL for the corporate film (transcoded, not bundled in /public).
NEXT_PUBLIC_FILM_URL=

# Local machine only (see above).
# ALLOW_LOCAL_URLS=true
