# Copy to `.env` (development values below). On the production server create `.env` from this
# file with the production values described in the comments; it is never committed.
# With NODE_ENV=production the API refuses to start with: placeholder secrets, http/localhost
# CORS origins, the development database credentials, or only one of WEB_REVALIDATE_URL /
# REVALIDATE_SECRET. See docs/production-deployment.md.

# Production: production
NODE_ENV=development
# Production: 127.0.0.1 (only Nginx and the website server reach the API).
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Development: matches docker-compose.yml (`pnpm db:up` from the repo root).
# Production: a dedicated user with a strong password (URL-encode special characters), e.g.
#   mysql://mahafeth_app:<password>@127.0.0.1:3306/mahafeth
# or over the Unix socket: mysql://mahafeth_app:<password>@localhost/mahafeth?socket=/var/run/mysqld/mysqld.sock
# Optional `?connection_limit=10` sets the pool size.
DATABASE_URL="mysql://mahafeth:mahafeth@localhost:3306/mahafeth"

# Origins allowed to call the API from a browser on another origin (comma-separated).
# Production: the exact https origins only, e.g. https://mahafeth.com,https://admin.mahafeth.com
# (the website and admin call /api/v1 on their own domain through Nginx, so this is a safety net).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Which proxies may set X-Forwarded-For (the client IP used by rate limits and the audit log).
# loopback = Nginx on the same machine (the documented production setup); a number = that many
# proxies in front (e.g. 2 behind a cloud load balancer + Nginx); false = the API is exposed directly.
TRUST_PROXY=loopback

# Requests per minute per IP for the whole API (0 disables). Sign-in has its own stricter limits.
RATE_LIMIT_PER_MINUTE=600
# IPs exempt from the global limit. Production: 127.0.0.1 so the website's server-side rendering
# (which calls the API directly, not through Nginx) never shares a bucket with visitors.
RATE_LIMIT_ALLOWLIST=

# Auth. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Production refuses the placeholder values below. Rotating JWT_SECRET signs everyone out.
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
# Token lifetime: 30m, 12h, 1d… Changing or resetting a password revokes older tokens.
JWT_EXPIRES_IN=12h

# Media uploads (served by the API at /uploads; Nginx routes /uploads to the API).
# Production: an absolute path outside the release directory, e.g. /var/lib/mahafeth/uploads,
# owned by the user running the API.
UPLOAD_DIR=uploads
# Keep /uploads unless media moves to a CDN (then the CDN origin, and CMS_MEDIA_URL on the website).
MEDIA_BASE_URL=/uploads
MAX_UPLOAD_MB=20

# Swagger UI at /api/docs (defaults to on outside production, off in production).
API_DOCS=true

# Refresh the website right after admin changes (same secret as apps/web REVALIDATE_SECRET).
# Leave both empty to rely on the website's 5-minute cache instead.
# Production: http://127.0.0.1:3000/api/revalidate (direct to the Next server; Nginx blocks it).
WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
REVALIDATE_SECRET=replace-with-a-shared-random-string

# Used by `pnpm db:seed` to create the first super admin. Only creates the account: an existing
# account is never changed. Production refuses the placeholder password and `.local` addresses;
# remove the password from this file after the first sign-in.
SEED_ADMIN_NAME="Mahafeth Admin"
SEED_ADMIN_EMAIL=admin@mahafeth.local
SEED_ADMIN_PASSWORD=change-me-now-please

# Backups (`pnpm backup`, see docs/backup-restore.md). Not read by the API.
# BACKUP_DIR=/var/backups/mahafeth
# BACKUP_KEEP=14
# Run mysqldump/mysql inside this container when the MySQL client tools are not installed.
# MYSQL_DOCKER_CONTAINER=mahafeth-mysql
