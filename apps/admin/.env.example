# Base path used by the API client, baked in at `vite build`.
# Keep `/api/v1` in production too: Nginx serves the admin and proxies /api and /uploads on the
# same domain to the backend, so the admin needs no CORS and never contains a backend hostname.
VITE_API_URL=/api/v1

# Public website origin for "view on site" links, baked in at `vite build`. Required for a
# production build: https and not localhost (ALLOW_LOCAL_URLS=true opts out on a developer machine).
VITE_SITE_URL=http://localhost:3000

# Development only: where the Vite dev server proxies `/api` and `/uploads`.
VITE_API_PROXY_TARGET=http://localhost:4000
